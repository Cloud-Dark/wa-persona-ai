# WA Persona AI — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your actual .env file.

# ─── LLM API Keys ───────────────────────────────────────────────────
# Primary LLM provider API key (Claude or OpenAI)
CLAUDE_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Bot Configuration ───────────────────────────────────────────────
# Comma-separated list of admin phone numbers (with country code, no +)
WPA_ADMIN_NUMBERS=628123456789,628987654321

# Path to config file (optional, defaults to config/config.yaml)
WPA_CONFIG_PATH=config/config.yaml

# ─── Logging ─────────────────────────────────────────────────────────
WPA_LOG_LEVEL=info
